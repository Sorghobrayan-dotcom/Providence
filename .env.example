# Server-side only. These are deliberately NOT prefixed with VITE_, because
# anything Vite exposes with that prefix is compiled into the browser bundle and
# would be readable by anyone visiting the deployed site.
#
# Copy this file to .env and fill in the values. The browser never sees them:
# it calls /scripture and /gloo on its own origin, and vite.config.ts attaches
# the credentials server side.

YOUVERSION_APP_KEY=

# Gloo AI Studio -> API Credentials. Not a static key: these two are exchanged
# for a short-lived bearer token at https://platform.ai.gloo.com/oauth2/token,
# and src/api/glooToken.ts caches it until just before it expires.
#
# The secret belongs in .env and nowhere else. .env is gitignored; if it ever
# reaches a terminal, a chat window or a screenshot, regenerate it in the Studio
# rather than hoping.
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
